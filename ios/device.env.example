# Copy to ios/device.env, keep it local, and fill in the values from Xcode and devicectl.
# These identifiers are not application secrets, but they are machine/account specific.

# Apple Developer Team ID shown in Xcode > Settings > Accounts.
HUE_BOARD_TEAM_ID=

# Provisioning UDID from Device Hub or `xcrun devicectl list devices`.
HUE_BOARD_DEVICE_ID=

# Use a unique reverse-DNS identifier if the default is unavailable to your team.
HUE_BOARD_BUNDLE_ID=com.wyattowalsh.HueBoard.dev

# Optional when Xcode 27.2+ is not the system-selected installation.
# HUE_BOARD_XCODE_PATH=/Applications/Xcode-beta.app
