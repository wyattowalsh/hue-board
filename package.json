{
  "name": "hue-board",
  "version": "5.3.0",
  "private": true,
  "description": "Offline Scriptable Hue controller and bundled React control deck",
  "scripts": {
    "build:frontend": "node frontend/build.cjs",
    "build": "node frontend/build.cjs && node build.cjs",
    "bundle": "node build.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:timing": "node tests/timing.cjs",
    "demo": "node tests/make-demo.cjs && node tests/make-layout-demo.cjs",
    "test:ui": "python tests/react_ui_qa.py",
    "test:e2e": "python tests/react_controller_e2e.py",
    "test:ui:everyday": "node tests/everyday_host.cjs --demo && python tests/v5_ui_qa.py",
    "test:e2e:everyday": "node tests/everyday_host.cjs --demo && python tests/v5_controller_e2e.py",
    "verify:release": "node scripts/check-published-bundle.cjs",
    "verify:rebuild": "node scripts/check-rebuilt-bundle.cjs",
    "export:ios-contract": "node scripts/export-ios-contract.cjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm verify:release && pnpm build && pnpm export:ios-contract && pnpm typecheck && pnpm test && pnpm test:timing"
  },
  "devDependencies": {
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1"
}
